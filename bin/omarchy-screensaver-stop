#!/usr/bin/env bash
# omarchy-screensaver-stop: Stop any running Omarchy screensaver instances
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/omarchy/bin:$PATH"

# Clean up stay-awake indicator if set by ambient screensaver mode
if [[ -f "$HOME/.local/state/omarchy/indicators/stay-awake-screensaver" ]]; then
  rm -f "$HOME/.local/state/omarchy/indicators/stay-awake-screensaver"
  rm -f "$HOME/.local/state/omarchy/indicators/stay-awake"
fi

bin="$HOME/.local/bin/omarchy-screensaver"
[[ ! -x "$bin" ]] && bin="omarchy-screensaver"
exec "$bin" --stop
