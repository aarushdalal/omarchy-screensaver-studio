#!/usr/bin/env bash
# Browse Screensaver Studio with Omarchy's native collection selector.
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/omarchy/bin:$PATH"
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-screensaver-browser-${UID}.lock"
flock -n 9 || exit 0
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
share_dir="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-screensaver"
if [[ -f "$share_dir/omarchy_screensaver/browser.py" ]]; then
  export PYTHONPATH="$share_dir${PYTHONPATH:+:$PYTHONPATH}"
else
  export PYTHONPATH="$script_dir/..${PYTHONPATH:+:$PYTHONPATH}"
fi
exec /usr/bin/python3 -m omarchy_screensaver.browser "$@"
