#!/usr/bin/env bash
# ==============================================================================
# omarchy-screensaver-preview: Launch the Omarchy screensaver in preview mode
# Usage: omarchy-screensaver-preview [MODE] [DURATION_SECONDS]
# ==============================================================================
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/omarchy/bin:$PATH"

mode=""
duration=""

for arg in "$@"; do
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    duration="$arg"
  elif [[ "$arg" =~ ^(clock|matrix|particles|warp|geometry|singularity|terminal|system|visualizer|aurora|cyber_nexus|synthwave|quantum_helix|topography|celestial_orbit|eclipse|ink_flow|rain|harmonograph|infinite_ripples|the_perfect_machine|ink_singularity|zen_geometry|fractal_bloom|particle_architect|harmonic_sculpture|circuit_genesis|circuit_weaver|mechanical_eternity|silk_continuum|infinite_marble_machine|domino_architect|wave_field|orbital_synchronization|infinite_origami|monolithic_construction|midnight_rain|liquid_obsidian|mercury_garden|event_horizon|infinite_zen_garden|ink_choreography)$ ]]; then
    mode="$arg"
  fi
done

bin="$HOME/.local/bin/omarchy-screensaver"
[[ ! -x "$bin" ]] && bin="omarchy-screensaver"
cmd=("$bin" --preview)
[[ -n "$mode" ]] && cmd+=(--mode "$mode")

if [[ -n "$duration" ]]; then
  exec timeout "${duration}s" "${cmd[@]}"
else
  exec "${cmd[@]}"
fi
