#!/usr/bin/env bash
# ==============================================================================
# omarchy-satisfying-settings: CLI management wrapper for DAEMON Satisfying
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHARE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-screensaver"

# Prepend relocatable search paths to PYTHONPATH
if [[ -d "$SHARE_DIR" ]]; then
  export PYTHONPATH="$SHARE_DIR:${PYTHONPATH:-}"
fi
if [[ -d "$SCRIPT_DIR/.." ]]; then
  export PYTHONPATH="$SCRIPT_DIR/..:${PYTHONPATH:-}"
fi

exec /usr/bin/python3 -m daemon_satisfying.preferences "$@"
