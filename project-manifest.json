{
  "name": "omarchy-screensaver-studio",
  "id": "daemon0.screensaver-studio",
  "version": "1.8.1",
  "description": "18-mode theme-aware screensaver studio with direct selection, an animated seven-gauge system cockpit, audio spectrum and native previews",
  "author": "Daemon0",
  "license": "MIT",
  "repository": "https://github.com/aarushdalal/omarchy-screensaver-studio",
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "compatibility": {
    "omarchy": "dev (13f18b2c) / 4.0.2",
    "quickshell": "0.3.1",
    "hyprland": "0.56.2"
  },
  "dependencies": {
    "required": [
      "omarchy",
      "quickshell",
      "python3",
      "gtk4",
      "python-gobject",
      "cairo"
    ],
    "optional": [
      "pipewire",
      "pipewire-pulse",
      "gcc"
    ]
  }
}
