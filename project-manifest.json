{
  "name": "omarchy-screensaver-studio",
  "id": "daemon0.screensaver-studio",
  "version": "2.0.0-beta.2",
  "description": "42-mode theme-aware screensaver studio (18 classic scenes and 24 DAEMON Satisfying procedural GPU prototypes) with direct selection, system telemetry and native previews",
  "author": "Daemon0",
  "license": "MIT",
  "repository": "https://github.com/aarushdalal/omarchy-screensaver-studio",
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "compatibility": {
    "omarchy": "dev (13f18b2c) / 4.0.2",
    "quickshell": "0.3.1",
    "hyprland": "0.56.2"
  },
  "dependencies": {
    "required": [
      "omarchy",
      "quickshell",
      "python3",
      "gtk4",
      "python-gobject",
      "cairo",
      "python-numpy",
      "mesa"
    ],
    "optional": [
      "pipewire",
      "pipewire-pulse",
      "gcc"
    ]
  }
}
